{
  "name": "@coniface/trial",
  "description": "A promise helper tool to inline them and reduce indentation-complexity.",
  "version": "2.0.0",
  "author": "Victor Simart <simart.victor@gmail.com>",
  "license": "MIT",
  "repository": "https://github.com/Coniface/trial",
  "bugs": {
    "url": "https://github.com/Coniface/trial/issues"
  },
  "homepage": "https://github.com/Coniface/trial#readme",
  "type": "module",
  "files": [
    "./dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write --ignore-unknown \"**/*.{json,ts}\"",
    "lint": "eslint .",
    "test": "node --import tsx --test \"**/*.spec.ts\"",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "pnpm run build"
  },
  "lint-staged": {
    "*.ts": "eslint --fix",
    "**/*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^9.1.1",
    "@types/node": "^20.12.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "tsup": "^8.0.2",
    "tsx": "^4.7.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0"
  },
  "packageManager": "pnpm@9.0.6+sha256.0624e30eff866cdeb363b15061bdb7fd9425b17bc1bb42c22f5f4efdea21f6b3",
  "keywords": [
    "promise",
    "async",
    "await",
    "typesript",
    "ts"
  ]
}
